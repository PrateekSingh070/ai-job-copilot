# Copy to .env at the repo root, then fill in DATABASE_URL and the two secrets.
# Every variable here is validated by server/src/config/env.js on startup.

# Server
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/copilot

# Must each be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_32plus_char_secret
JWT_REFRESH_SECRET=replace_with_32plus_char_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173
SERVER_PUBLIC_URL=http://localhost:4000

# AI. `mock` is a deterministic local implementation that needs no API key,
# so the app and its tests run offline. Set to `openai` or `anthropic` and
# supply the matching key to call a real model.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
AI_MAX_INPUT_CHARS=4000
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS_RESUME=450
AI_MAX_OUTPUT_TOKENS_LETTER=900
AI_MAX_OUTPUT_TOKENS_GAP=600
AI_MAX_OUTPUT_TOKENS_CHAT=700
AI_MAX_OUTPUT_TOKENS_IMPORT=800
AI_RATE_LIMIT_PER_MINUTE=8

# Embeddings (for RAG). Anthropic has no embeddings API, so this switch is
# independent of AI_PROVIDER. `mock` produces deterministic bag-of-words vectors.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small

# Job import from URL (Phase 4).
IMPORT_FETCH_TIMEOUT_MS=10000
IMPORT_MAX_HTML_BYTES=2000000

# RAG chat (Phase 5).
RAG_TOP_K=6

# Login/register throttle: 20 attempts per 15 minutes per IP.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Optional error monitoring.
SENTRY_DSN=

# Client (build-time). Leave empty when the API is served from the same
# origin as the SPA.
VITE_API_URL=http://localhost:4000

# Production single-host only: absolute path to the Vite build output, so the
# API can serve the SPA. Set automatically in the Dockerfile.
# CLIENT_STATIC_DIR=/app/client/dist
